# Copy to .env. Consumed by compose.yaml only (be/ and fe/ have their own
# .env.example for local, non-Docker runs).
COMPOSE_PROJECT_NAME=saju

# postgres service
DB_HOST_PORT=5433
DB_NAME=saju
DB_USERNAME=app
DB_PASSWORD=app

# api service (profile "app")
APP_ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]
# Keep in sync with be/.python-version.
PYTHON_VERSION=3.14.7

# web service (profile "app") — baked into the build, so changing it
# requires rebuilding the image (`make up` / `docker compose build web`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
