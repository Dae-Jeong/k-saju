# Single source of truth for local environment variables. Copy to .env
# (gitignored) with `make env`. The app reads only OS environment variables —
# never .env files directly. This file feeds:
#   - infra/docker/compose.local.yaml, via interpolation (${VAR:?...})
#   - be/ and fe/ host processes, via the Makefile (`set -a; . ./.env`)
# See docs/env.md for the full flow.
#
# Each key is marked `# required` or `# optional (default: X)`.

# --- compose ---
# required
COMPOSE_PROJECT_NAME=saju

# --- db (postgres service + be DB_*) ---
# required
DB_HOST=localhost
# required
DB_PORT=5433
# required — compose maps this to the postgres container's published port;
# keep equal to DB_PORT for local (host) runs.
DB_HOST_PORT=5433
# required
DB_NAME=saju
# required
DB_USERNAME=app
# required
DB_PASSWORD=app
# optional (default: 4)
DB_POOL_SIZE=4
# optional (default: 0)
DB_POOL_MAX_OVERFLOW=0
# optional (default: 2)
DB_POOL_TIMEOUT_SECONDS=2

# --- api (be Settings) ---
# required
APP_ENVIRONMENT=local
# optional (default: API)
APP_NAME=API
# optional (default: 0.1.0)
SERVICE_VERSION=0.1.0
# optional (default: 127.0.0.1; containers override to 0.0.0.0)
SERVER_HOST=127.0.0.1
# optional (default: 8000)
SERVER_PORT=8000
# optional (default: 15) — Uvicorn graceful shutdown drain budget, seconds
SHUTDOWN_TIMEOUT_SECONDS=15
# optional (default: info) — debug / info / warning / error / critical
LOG_LEVEL=info
# optional (default: ["http://localhost:3000"]) — JSON array. Single-quoted
# so the Makefile's shell `source` keeps the inner double quotes intact.
CORS_ORIGINS='["http://localhost:3000"]'
# Keep in sync with be/.python-version. Used only by the api Docker build.
# optional (default: 3.14.7)
PYTHON_VERSION=3.14.7

# --- web (fe env.ts) ---
# required — baked into the build (NEXT_PUBLIC_*); changing it requires a
# rebuild (`make up` / `docker compose build web`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

