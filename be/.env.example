# Copy this file to .env and change only what you need.
# Process env vars > .env > Settings defaults, in that priority order.
APP_NAME=API
SERVICE_VERSION=0.1.0
APP_ENVIRONMENT=local
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# How long Uvicorn waits for in-flight requests during shutdown. Not the full cleanup budget.
SHUTDOWN_TIMEOUT_SECONDS=15
# debug / info / warning / error / critical
LOG_LEVEL=info
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL — local default targets the saju-postgres container (port 5433).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=saju
DB_USERNAME=app
DB_PASSWORD=app
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=2
